# Keystatic GitHub 模式所需环境变量（阶段 B 启用后生效）
# 本文件仅作字段说明，真实值走 Keystatic「Create GitHub App」引导流程生成到 .env（不入库），
# 并同步配置到 Cloudflare Workers 的环境变量面板。
#
# KEYSTATIC_GITHUB_CLIENT_ID=       # GitHub App 的 Client ID（引导流程生成）
# KEYSTATIC_GITHUB_CLIENT_SECRET=   # GitHub App 的 Client Secret（引导流程生成）
# KEYSTATIC_SECRET=                 # ≥32 字符随机串，用于会话签名（自行生成）
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG= # GitHub App 的 slug（引导流程生成，Astro 用 PUBLIC_ 前缀）
