---
/**
 * 姓名印章式作者头像（SVG，零版权风险、零图片额度）
 * - 中文：竖排姓名字，朱砂印底白字（阴文印）
 * - 英文：姓名首字母横排
 * - 印章外点缀星图纹（呼应全站科幻调性），星点位置由姓名哈希决定（每位作者稳定唯一）
 */
interface Props {
  name: string;
  lang?: 'zh' | 'en';
  /** card: 3:4 封面位图；hero: 方形详情页大图 */
  variant?: 'card' | 'hero';
  class?: string;
}

const { name, lang = 'zh', variant = 'card', class: cls } = Astro.props;

const isCard = variant === 'card';
const W = isCard ? 300 : 260;
const H = isCard ? 400 : 260;

// 印文：中文取姓名汉字（≤4），英文取各词首字母（≤3）
const chars =
  lang === 'zh'
    ? [...name].filter((c) => /\S/.test(c)).slice(0, 4)
    : name.split(/\s+/).map((w) => w[0]?.toUpperCase() ?? '').slice(0, 3);

// 印章几何
const seal = isCard ? 186 : 205;
const sx = (W - seal) / 2;
const sy = (H - seal) / 2;
const innerPad = 9; // 内框内缩
const frameH = seal - innerPad * 2; // 内框高度

// === 字号自适应：基于实测「余繁新语」字形 ink metrics ===
//  实测 PIL bbox (fs=80 → 64×72)：ink 宽 0.8em / 高 0.9em / ink 顶在 baseline 上方 0.766em
//  advance width 0.8em（不是 1em），text-anchor=middle 居中后 x 跨度 ±0.4em
const INK_W = 0.8;
const INK_H_EM = 0.9;
const INK_TOP_EM = 0.766; // ink 顶距 baseline（em 比，>0 表示 baseline 之上）
// 相邻基线距离（1.02 → 0.12em 视觉空隙；LINE 越小越紧凑，1.0 即刚好无空隙）
const LINE = 1.02;
// 整体 ink 高度占内框比例（0.80 = 上下各留 10% 内框作 padding）
const USABLE = 0.80;
const n = Math.max(chars.length, 1);
// 总体 ink 高度 = fs × ((n-1)·LINE + INK_H_EM) ≤ frameH × USABLE
let fs = (frameH * USABLE) / ((n - 1) * LINE + INK_H_EM);
fs = Math.min(fs, lang === 'zh' ? 96 : 78); // 单字不过大
// 最小字号防 3/4 字过小（保持印章庄重感）
const MIN_FS: Record<number, number> = { 1: 54, 2: 54, 3: 42, 4: 32 };
fs = Math.max(fs, MIN_FS[n] ?? 30);
// 实际 ink 高度（用于精确居中）
const inkH = (n - 1) * LINE * fs + INK_H_EM * fs;
// 让 ink 块在内框内垂直居中
const topPad = (frameH - inkH) / 2;
// 第 0 个字的基线 y = 内框顶 + 顶 padding + INK_TOP_EM×fs
const baseline0 = sy + innerPad + topPad + INK_TOP_EM * fs;

// 姓名哈希 → 星点伪随机（每位作者图案稳定）
let h = 2166136261;
for (let i = 0; i < name.length; i++) {
  h ^= name.charCodeAt(i);
  h = Math.imul(h, 16777619);
}
const rnd = () => {
  h ^= h << 13; h ^= h >>> 17; h ^= h << 5;
  return ((h >>> 0) % 1000) / 1000;
};

const stars = Array.from({ length: 9 }, () => ({
  x: 14 + rnd() * (W - 28),
  y: 14 + rnd() * (H - 28),
  r: 1.1 + rnd() * 1.7,
  o: 0.22 + rnd() * 0.4,
}));
// 连线取相邻星点成一条"星座线"
const link = stars.slice(0, 5);
---

<svg
  class={cls ? `author-seal ${cls}` : 'author-seal'}
  viewBox={`0 0 ${W} ${H}`}
  width="100%"
  height="100%"
  role="img"
  aria-label={name}
  xmlns="http://www.w3.org/2000/svg"
>
  {/* 星图纹（低透明度，避开印章区域视觉干扰） */}
  <g stroke="var(--accent)" stroke-width="1" fill="none" opacity="0.35">
    <polyline
      points={link.map((s) => `${s.x.toFixed(1)},${s.y.toFixed(1)}`).join(' ')}
      stroke-dasharray="2 4"
    />
  </g>
  {stars.map((s) => (
    <circle cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r={s.r.toFixed(1)} fill="var(--accent)" opacity={s.o.toFixed(2)} />
  ))}

  {/* 印章：朱砂底 + 白字 + 内框 */}
  <g>
    <rect
      x={sx}
      y={sy}
      width={seal}
      height={seal}
      rx="12"
      fill="#b03a2c"
    />
    <rect
      x={sx + 9}
      y={sy + 9}
      width={seal - 18}
      height={seal - 18}
      rx="7"
      fill="none"
      stroke="#f7ece4"
      stroke-width="2.5"
      opacity="0.85"
    />
    {lang === 'zh' ? (
      // 中文竖排：基线 y_i = baseline0 + i·LINE·fs；ink 顶在 baseline 上方 INK_TOP_EM·fs
      chars.map((c, i) => (
        <text
          x={W / 2}
          y={baseline0 + i * LINE * fs}
          text-anchor="middle"
          class="seal-zh"
          font-size={fs}
          fill="#f7ece4"
        >
          {c}
        </text>
      ))
    ) : (
      // 英文首字母横排
      <text
        x={W / 2}
        y={H / 2 + fs * 0.18}
        text-anchor="middle"
        class="seal-en"
        font-size={chars.length > 2 ? fs * 0.62 : fs * 0.78}
        letter-spacing="2"
        fill="#f7ece4"
      >
        {chars.join('')}
      </text>
    )}
  </g>
</svg>

<style>
  .author-seal {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* 印章印文样式：CSS 接管 font-family（SVG 表现属性不支持 var()） */
  .author-seal .seal-zh {
    font-family: 'ZhuanZhi', 'YuFanXinYu', '方正小篆体', 'STZhongsong',
      'STLiti', '华文隶书', 'STKaiti', 'Songti SC', 'Noto Serif SC', serif;
    font-weight: 400;
    font-feature-settings: "kern" 1;
  }
  .author-seal .seal-en {
    font-family: 'STKaiti', 'KaiTi', 'Georgia', serif;
    font-weight: 600;
  }
</style>
