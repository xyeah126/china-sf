---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

// 页面正文来自后台可编辑的独立页面（src/content/pages/<lang>/about.md）
const entry = await getEntry(lang === 'zh' ? 'pages-zh' : 'pages-en', 'about');
const { Content } = await render(entry!);
---

<BaseLayout lang={lang} title={entry?.data.title ?? t.navAbout}>
  <section class="section">
    <h1 class="section-title">{entry?.data.title ?? t.navAbout}</h1>

    <div class="detail-body about-body">
      <Content />
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* 迁移自原 About.astro 的 .subhead：小节标题保持原视觉 */
  .about-body h2 {
    font-family: var(--font-sans);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
    margin: 30px 0 12px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--line);
  }
</style>
