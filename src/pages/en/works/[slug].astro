---
import type { GetStaticPaths } from 'astro';
import WorkDetail from '../../../components/pages/WorkDetail.astro';
import { getWorks } from '../../../lib/content';

export const getStaticPaths = (async () => {
  const items = await getWorks('en');
  return items.map((x) => ({
    params: { slug: x.slug },
    props: { entry: x.entry, slug: x.slug, isFallback: x.isFallback },
  }));
}) satisfies GetStaticPaths;

const { entry, slug, isFallback } = Astro.props;
---

<WorkDetail entry={entry} lang="en" slug={slug} isFallback={isFallback} />
